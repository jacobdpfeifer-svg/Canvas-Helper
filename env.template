# Jacob IBE — CU Boulder Canvas (personal fork)
# Copy to .env and set CANVAS_API_TOKEN. Never commit .env.

CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_API_URL=https://canvas.colorado.edu/api/v1

MCP_SERVER_NAME=jacob-canvas-ibe
DEBUG=false
API_TIMEOUT=30
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10
LOG_LEVEL=INFO
LOG_API_REQUESTS=false

# Self-only student fork — no FERPA anonymization map
ENABLE_DATA_ANONYMIZATION=false
ANONYMIZATION_DEBUG=false
LOG_REDACT_PII=true

# Student-only runtime (hard-coded in server; kept here for clarity)
CANVAS_ROLE=student

# Enable Tier-1 student writes (submit still uses preview→confirm tokens)
STUDENT_WRITE_TOOLS=submit_assignment,comment_on_my_submission,mark_module_item_done

# Freshman syllabi may omit agent policy; allow until a course opts out
COURSE_AGENT_POLICY_ENABLED=true
COURSE_AGENT_POLICY_DEFAULT=allow

INSTITUTION_NAME=University of Colorado Boulder
TIMEZONE=America/Denver

# Voice intake (cd browser && npm run voice) — Gemini Live API key from https://aistudio.google.com/apikey
# Use a paid-tier key: audio of your goals goes to Google. See docs/VOICE.md.
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=        # list what your key can use: cd browser && npm run voice-models
# VOICE_NAME=               # optional prebuilt voice, e.g. Kore
# VOICE_PORT=8787
# VOICE_SILENCE_MS=1500     # silence that ends your turn; raise if it cuts you off mid-thought

# Composio (optional CLI calendar apply: cd browser && npm run sync-calendar -- --apply)
# COMPOSIO_API_KEY=
# COMPOSIO_GOOGLE_CALENDAR_ACCOUNT_ID=
