{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "local.jacob-pfeifer/canvas-mcp-ibe",
  "description": "Personal student-only Canvas MCP for Jacob Pfeifer (CU Boulder IBE). Not published.",
  "version": "1.11.0",
  "repository": {
    "url": "https://github.com/vishalsachdev/canvas-mcp",
    "source": "github"
  },
  "tags": [
    "education",
    "lms",
    "canvas",
    "student-tools",
    "personal-fork"
  ],
  "license": "MIT",
  "transport": {
    "type": "stdio"
  },
  "configuration": {
    "type": "env",
    "env": {
      "CANVAS_API_TOKEN": {
        "description": "Your Canvas API access token (CU Boulder student).",
        "required": true
      },
      "CANVAS_API_URL": {
        "description": "Canvas API URL (https://canvas.colorado.edu/api/v1)",
        "required": true
      },
      "ENABLE_DATA_ANONYMIZATION": {
        "description": "Student identity anonymization (off by default in this personal student fork).",
        "required": false,
        "default": "false"
      },
      "ANONYMIZATION_DEBUG": {
        "description": "Enable anonymization debugging output",
        "required": false,
        "default": "false"
      }
    }
  }
}
