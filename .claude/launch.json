{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kairos-app",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--port",
        "1422",
        "--strictPort",
        "app"
      ],
      "port": 1422,
      "autoPort": false
    },
    {
      "name": "landing",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--port",
        "1425",
        "--strictPort",
        "landing"
      ],
      "port": 1425
    }
  ]
}
