{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "productname-app",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--config",
        "app/vite.config.ts",
        "--port",
        "1420",
        "--strictPort",
        "app"
      ],
      "port": 1420
    },
    {
      "name": "productname-app-alt",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "app/node_modules/vite/bin/vite.js",
        "--config",
        "app/vite.config.ts",
        "--port",
        "1422",
        "--strictPort",
        "app"
      ],
      "port": 1422
    }
  ]
}
