{
  "productName": "ProductName",
  "version": "0.1.0",
  "identifier": "com.productname.student",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ProductName",
        "width": 420,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "autostart": {
      "macos": true
    }
  }
}
