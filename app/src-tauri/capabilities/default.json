{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default ProductName capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "allow-set-dock-mode",
    "allow-show-dock",
    "allow-hide-dock",
    "allow-sync-canvas",
    "allow-read-top3",
    "allow-open-canvas-sso",
    "allow-save-onboarding",
    "allow-save-learning-profile",
    "allow-read-due-reviews",
    "allow-read-brief-streak",
    "allow-read-learn-progress",
    "allow-read-evaluation-compare",
    "allow-record-review-outcome",
    "allow-read-commitment",
    "allow-set-commitment",
    "allow-resolve-commitment",
    "allow-read-check-intention",
    "allow-route-intent"
  ]
}
